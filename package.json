{
    "name": "cheapside",
    "private": true,
    "version": "0.3.0",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/giovani-freitag/cheapside"
    },
    "homepage": "https://giovani-freitag.github.io/cheapside/",
    "description": "The twenty cheapest companies on B3 by EV/EBIT, with every filter, exclusion and input shown.",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "data:build": "npm run data:capture && npm run data:screen",
        "data:verdicts": "vite-node scripts/build-verdicts.ts",
        "data:capture": "vite-node scripts/capture-market.ts",
        "data:screen": "vite-node scripts/build-screen.ts"
    },
    "dependencies": {
        "lucide-react": "^1.32.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.5",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.8.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "fflate": "^0.8.2",
        "globals": "^17.11.0",
        "jsdom": "^30.0.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.11"
    }
}
